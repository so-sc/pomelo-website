---
const { code } = Astro.props;
---

<div class="mermaid-wrapper my-5 overflow-x-auto rounded-lg border border-border p-4">
  <pre class="mermaid flex justify-center">{code.trim()}</pre>
</div>

<script>
  import mermaid from "mermaid";

  // The design tokens hold bare HSL triplets, so wrap them before handing them to mermaid.
  function token(name: string) {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return `hsl(${value})`;
  }

  function themeVariables() {
    return {
      fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif",
      fontSize: "14px",
      background: "transparent",
      primaryColor: token("--secondary"),
      primaryTextColor: token("--foreground"),
      primaryBorderColor: token("--primary"),
      secondaryColor: token("--muted"),
      tertiaryColor: token("--muted"),
      lineColor: token("--muted-foreground"),
      textColor: token("--foreground"),
      edgeLabelBackground: token("--background"),
      clusterBkg: "transparent",
      clusterBorder: token("--border"),
    };
  }

  async function renderAll() {
    mermaid.initialize({
      startOnLoad: false,
      theme: "base",
      themeVariables: themeVariables(),
      securityLevel: "strict",
    });
    const nodes = document.querySelectorAll<HTMLElement>(".mermaid");
    nodes.forEach((node) => {
      if (!node.dataset.source) node.dataset.source = node.textContent ?? "";
      node.removeAttribute("data-processed");
      node.textContent = node.dataset.source ?? "";
    });
    if (nodes.length) await mermaid.run({ nodes: Array.from(nodes) });
  }

  renderAll();

  new MutationObserver(renderAll).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>
